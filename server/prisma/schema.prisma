// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Issue 3 (Lab 1) — IT request categories
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Lab 3 Issue 2 — real users (renamed in place from Lab 2's RequesterUser so every existing
// Ticket.requesterId keeps its meaning — docs/lab-03/specification.md BR-46). One role per user
// (BR-12); passwords are scrypt hashes, never plaintext (BR-04).
enum UserRole {
  REQUESTER
  IT_STAFF
  ADMIN
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  passwordHash       String
  role               UserRole  @default(REQUESTER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tickets            Ticket[]  @relation("TicketRequester")
  ownedTickets       Ticket[]  @relation("TicketOwner")
  sessions           Session[]
}

// Lab 3 Issue 2 — server-side sessions (BR-08). Only the SHA-256 of the cookie token is stored.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// Lab 2 Issue 3 — Related System (the specific service/device/platform a ticket is about).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Lab 3 Issue 3 — full workflow (docs/lab-03/specification.md BR-25/BR-30).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Per-year counter backing BR-01's ticket-number format (TKT-{year}-{6 digits}); incremented
// atomically in one UPDATE per creation so numbers never collide under concurrent requests.
model TicketSequence {
  year      Int @id
  lastValue Int @default(0)
}

model Ticket {
  id                Int           @id @default(autoincrement())
  ticketNumber      String        @unique
  requesterId       Int
  requester         User          @relation("TicketRequester", fields: [requesterId], references: [id])
  // Lab 3 Issue 3 — zero or one Ticket Owner (active IT Staff / Administrator, BR-23), IT Priority
  // (copied from requestedPriority at creation, BR-24), and the Requester's "appears resolved"
  // signal (BR-32).
  ownerId           Int?
  owner             User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  itPriority        Priority
  requesterResolvedAt DateTime?
  categoryId        Int
  category          Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority Priority
  currentStatus     TicketStatus  @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attachments       Attachment[]

  @@index([requesterId])
  @@index([createdAt])
  @@index([ownerId])
  @@index([currentStatus])
  @@index([itPriority])
}

// Lab 2 Issue 3 (created here since Create Ticket needs attachment upload) — soft-removal
// fields are already present so Issue 5 doesn't need another migration for them.
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removedReason    String?

  @@index([ticketId])
}
